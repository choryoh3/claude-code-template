# apps/api/.env.example  ->  コピーして .env を作る (.env はコミットしない)
# ローカル開発では dev スクリプトが .env を自動で読み込む。Vercel では Project Settings > Environment Variables に登録する。

# ブラウザからの呼び出しを許可するフロントエンドのオリジン (CORS)
WEB_ORIGIN=http://localhost:3000

# ローカル開発サーバーのポート
PORT=8787

# Neon (PostgreSQL) の接続文字列。未設定ならメモリ上に保存する (再起動で消える)
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
